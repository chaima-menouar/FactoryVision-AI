# FactoryVision backend runtime
FACTORYVISION_MODEL_CHECKPOINT=artifacts/model.ckpt
FACTORYVISION_DB_BACKEND=sqlite
FACTORYVISION_DB_PATH=runtime/factoryvision.db
FACTORYVISION_CORS_ORIGINS=http://localhost:5173
FACTORYVISION_FRONTEND_DIST=frontend/dist

# Zero-cost safety limits
FACTORYVISION_DAILY_INSPECTION_LIMIT=25
FACTORYVISION_MAX_UPLOAD_BYTES=6291456

# Azure Cosmos DB for NoSQL (used only when FACTORYVISION_DB_BACKEND=cosmos)
FACTORYVISION_COSMOS_ENDPOINT=
FACTORYVISION_COSMOS_KEY=
FACTORYVISION_COSMOS_DATABASE=factoryvision
FACTORYVISION_COSMOS_CONTAINER=inspections

# Quality copilot (disabled until a paid provider is intentionally configured)
FACTORYVISION_COPILOT_PROVIDER=disabled
FACTORYVISION_COPILOT_TIMEOUT_SECONDS=30
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Frontend development/build
VITE_API_BASE_URL=http://localhost:8000
